{
  "name": "kairos-whatsapp-bot-root",
  "version": "1.0.0",
  "description": "Kairos Lite Official WhatsApp Chatbot backend powered by Meta WhatsApp Cloud API",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "build": "npm install --prefix backend",
    "postinstall": "npm install --prefix backend",
    "dev": "npm run dev --prefix backend",
    "test": "npm test --prefix backend",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop kairos-bot",
    "pm2:restart": "pm2 restart kairos-bot",
    "pm2:logs": "pm2 logs kairos-bot"
  },
  "keywords": [
    "whatsapp",
    "meta-cloud-api",
    "chatbot",
    "kairos-lite"
  ],
  "author": "Kairos Lite",
  "license": "ISC"
}
